<?xml version="1.0" encoding="utf-8"?>
<!--
  玻璃浏览器 · AndroidManifest

  说明：本项目**不使用任何 XML 布局、不使用 EditText / View 体系**，
  界面 100% 由 Jetpack Compose + Material 3 构建。
  这里出现的 XML 只有两类，Android 平台上无法避免：
    · AndroidManifest.xml（应用清单，没有替代品）
    · res/values/strings.xml、res/drawable/ic_globe.xml（字符串与矢量图标资源）
  没有一处是 layout/。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+ 包可见性：检测"设备上有没有别的浏览器 / 自己是不是默认浏览器"必须声明，
         否则 resolveActivity() 恒为 null，"默认浏览器检测"永远返回 false -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".GlassBrowserApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlassBrowser"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.GlassBrowser">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ★ 设为"默认浏览器"的核心过滤器：三个 category 一个不能少，http/https 两个 scheme 都要写 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- 系统搜索键 / 全局搜索框 -->
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- 外部 App 分享一段文字 → 进来直接搜索 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
